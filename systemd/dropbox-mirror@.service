[Unit]
Description=Tiny Dropbox Mirror for %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/opt/tiny-dropbox-backup
ExecStart=/opt/tiny-dropbox-backup/.venv/bin/dropbox-mirror --config /etc/dropbox-mirror/config.ini run
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=infinity
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dropbox-mirror /var/log/dropbox-mirror

[Install]
WantedBy=multi-user.target
